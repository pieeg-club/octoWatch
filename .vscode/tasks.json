{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Garmin: Build & Run in Simulator (Venu 3)",
            "type": "shell",
            "command": "powershell",
            "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\dev.ps1", "watch-sim"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Garmin: Build Watch App (.prg)",
            "type": "shell",
            "command": "powershell",
            "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\dev.ps1", "watch-build"],
            "group": "build"
        },
        {
            "label": "Firmware: Flash & Monitor Octopus-16 (ESP32-S3)",
            "type": "shell",
            "command": "powershell",
            "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\dev.ps1", "fw-flash-monitor"],
            "group": "build"
        },
        {
            "label": "Firmware: Build Octopus-16 (ESP32-S3)",
            "type": "shell",
            "command": "powershell",
            "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\dev.ps1", "fw-build"],
            "group": "build"
        },
        {
            "label": "Firmware: Serial Monitor (COM3)",
            "type": "shell",
            "command": "powershell",
            "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\dev.ps1", "fw-monitor"]
        },
        {
            "label": "BLE: Scan for Octopus-16",
            "type": "shell",
            "command": "powershell",
            "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\dev.ps1", "ble-scan"]
        },
        {
            "label": "BLE: Capture & Decode 0xA1 Packets",
            "type": "shell",
            "command": "powershell",
            "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\dev.ps1", "ble-capture"]
        }
    ]
}
